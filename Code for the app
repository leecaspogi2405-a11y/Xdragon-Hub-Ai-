<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dev Xdragon Hub AI - Roblox Creation Suite</title>
    <style>
        :root {
            --primary: #6c5ce7;
            --secondary: #00cec9;
            --dark: #2d3436;
            --darker: #1e272e;
            --light: #dfe6e9;
            --accent: #fd79a8;
            --success: #00b894;
            --warning: #fdcb6e;
            --danger: #e17055;
            --xdrg-lite: #74b9ff;
            --xdrg-flash: #ffeaa7;
            --xdrg-coder: #a29bfe;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .app-container {
            width: 100%;
            max-width: 1400px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 90vh;
        }

        .header {
            background: linear-gradient(135deg, var(--dark) 0%, var(--darker) 100%);
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid var(--primary);
        }

        .header h1 {
            color: white;
            font-size: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header h1 .icon {
            font-size: 30px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
            color: white;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
        }

        .main-content {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        .sidebar {
            width: 250px;
            background: var(--darker);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .sidebar-btn {
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: left;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(5px);
        }

        .sidebar-btn.active {
            background: var(--primary);
            border-color: var(--primary);
        }

        .workspace {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 20px;
            gap: 20px;
            overflow-y: auto;
        }

        .model-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .model-card {
            padding: 20px;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
            border: 3px solid transparent;
            text-align: center;
        }

        .model-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .model-card.selected {
            border-color: var(--primary);
            box-shadow: 0 10px 30px rgba(108, 92, 231, 0.3);
        }

        .model-xdrg-lite {
            background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
            color: white;
        }

        .model-xdrg-flash {
            background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
            color: #2d3436;
        }

        .model-xdrg-coder {
            background: linear-gradient(135deg, #a29bfe 0%, #6c5ce7 100%);
            color: white;
        }

        .chat-container {
            flex: 1;
            background: white;
            border-radius: 15px;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
            border: 2px solid #e0e0e0;
            min-height: 300px;
        }

        .message {
            max-width: 80%;
            padding: 12px 18px;
            border-radius: 15px;
            position: relative;
            animation: fadeIn 0.3s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message.user {
            background: var(--primary);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 5px;
        }

        .message.ai {
            background: #f5f5f5;
            color: var(--dark);
            align-self: flex-start;
            border-bottom-left-radius: 5px;
        }

        .message .timestamp {
            font-size: 10px;
            opacity: 0.7;
            margin-top: 5px;
        }

        .code-block {
            background: var(--darker);
            color: #00ff00;
            padding: 15px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            overflow-x: auto;
            margin: 10px 0;
            position: relative;
        }

        .code-block .copy-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--primary);
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
        }

        .input-container {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .prompt-input {
            flex: 1;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            resize: none;
            min-height: 60px;
            max-height: 120px;
        }

        .prompt-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .send-btn {
            padding: 15px 30px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .send-btn:hover {
            background: #5f3dc4;
            transform: scale(1.05);
        }

        .cloud-status {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: white;
            padding: 10px 20px;
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--success);
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .saved-scripts {
            background: white;
            border-radius: 15px;
            padding: 15px;
            border: 2px solid #e0e0e0;
            max-height: 400px;
            overflow-y: auto;
        }

        .saved-script-item {
            padding: 10px;
            background: #f5f5f5;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .saved-script-item:hover {
            background: #e0e0e0;
            transform: translateX(5px);
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="header">
            <h1>
                <span class="icon">🤖</span>
                Dev Xdragon Hub AI
            </h1>
            <div class="user-info">
                <span id="username">Loading...</span>
                <div class="user-avatar" id="userAvatar">D</div>
            </div>
        </div>

        <div class="main-content">
            <div class="sidebar">
                <button class="sidebar-btn active" onclick="switchTab('studio')">
                    🏗️ Studio Lite
                </button>
                <button class="sidebar-btn" onclick="switchTab('ai')">
                    🤖 AI Code Generator
                </button>
                <button class="sidebar-btn" onclick="switchTab('saved')">
                    💾 Saved Scripts
                </button>
                <button class="sidebar-btn" onclick="switchTab('settings')">
                    ⚙️ Settings
                </button>
            </div>

            <div class="workspace">
                <div id="studioTab" class="tab-content">
                    <h2>🏗️ Roblox Studio Lite</h2>
                    <div class="model-selector">
                        <div class="model-card model-xdrg-lite selected" onclick="selectModel('xdrg-lite')">
                            <h3>⚡ Xdrg Lite</h3>
                            <p>Fast & Lightweight</p>
                            <small>For quick scripts</small>
                        </div>
                        <div class="model-card model-xdrg-flash" onclick="selectModel('xdrg-flash')">
                            <h3>🚀 Xdrg Flash</h3>
                            <p>High Performance</p>
                            <small>For complex systems</small>
                        </div>
                        <div class="model-card model-xdrg-coder" onclick="selectModel('xdrg-coder')">
                            <h3>💻 Xdrg Coder</h3>
                            <p>Advanced AI</p>
                            <small>For expert scripts</small>
                        </div>
                    </div>
                    <div id="modelInfo">
                        <h3>Selected Model: Xdrg Lite</h3>
                        <p>Optimized for speed and efficiency. Best for simple scripts and rapid prototyping.</p>
                    </div>
                </div>

                <div id="aiTab" class="tab-content" style="display: none;">
                    <h2>🤖 AI Code Generator</h2>
                    <div class="chat-container" id="chatContainer">
                        <div class="message ai">
                            <strong>Dev Xdragon Hub AI:</strong><br>
                            Hello! I'm your AI-powered Roblox scripting assistant. Describe what you want to create, and I'll generate the code for you!
                            <div class="timestamp">Just now</div>
                        </div>
                    </div>
                    <div class="input-container">
                        <textarea class="prompt-input" id="promptInput" placeholder="Describe your Roblox script... (e.g., 'Create a speed boost script', 'Make a teleport system', 'Generate a combat system')"></textarea>
                        <button class="send-btn" onclick="sendPrompt()">Send 🚀</button>
                    </div>
                </div>

                <div id="savedTab" class="tab-content" style="display: none;">
                    <h2>💾 Saved Scripts</h2>
                    <div class="saved-scripts" id="savedScripts">
                        <p>No saved scripts yet. Generate some code first!</p>
                    </div>
                </div>

                <div id="settingsTab" class="tab-content" style="display: none;">
                    <h2>⚙️ Settings</h2>
                    <div class="saved-scripts">
                        <h3>Account Settings</h3>
                        <p>Username: <span id="settingsUsername">Loading...</span></p>
                        <p>Cloud Storage: <span style="color: green;">Connected ✅</span></p>
                        <p>AI Model: <span id="settingsModel">Xdrg Lite</span></p>
                        <button class="send-btn" onclick="clearCloud()" style="margin-top: 20px;">Clear Cloud Data 🗑️</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="cloud-status">
        <div class="status-dot"></div>
        <span>CloudBase Connected</span>
    </div>

    <script>
        // ==================== CLOUDBASE/DATASTORE ====================
        class CloudBase {
            constructor() {
                this.initialize();
            }

            initialize() {
                // Load or create database
                this.database = this.loadDatabase();
                this.user = this.loadUser();
                this.saveUser();
            }

            loadDatabase() {
                const data = localStorage.getItem('xdragon_db');
                if (data) {
                    return JSON.parse(data);
                } else {
                    const newDb = {
                        users: {},
                        messages: [],
                        scripts: [],
                        models: {
                            'xdrg-lite': {
                                name: 'Xdrg Lite',
                                description: 'Fast & Lightweight model for quick scripts',
                                speed: 100,
                                complexity: 50,
                                specialization: ['basic', 'movement', 'simple systems']
                            },
                            'xdrg-flash': {
                                name: 'Xdrg Flash',
                                description: 'High Performance model for complex systems',
                                speed: 80,
                                complexity: 80,
                                specialization: ['advanced', 'combat', 'optimization']
                            },
                            'xdrg-coder': {
                                name: 'Xdrg Coder',
                                description: 'Advanced AI model for expert scripts',
                                speed: 60,
                                complexity: 100,
                                specialization: ['expert', 'AI', 'complex algorithms']
                            }
                        }
                    };
                    localStorage.setItem('xdragon_db', JSON.stringify(newDb));
                    return newDb;
                }
            }

            saveDatabase() {
                localStorage.setItem('xdragon_db', JSON.stringify(this.database));
            }

            loadUser() {
                const user = localStorage.getItem('xdragon_user');
                if (user) {
                    return JSON.parse(user);
                } else {
                    const newUser = {
                        id: this.generateId(),
                        username: 'User_' + Math.floor(Math.random() * 10000),
                        createdAt: new Date().toISOString(),
                        selectedModel: 'xdrg-lite',
                        preferences: {
                            theme: 'dark',
                            autoSave: true
                        }
                    };
                    localStorage.setItem('xdragon_user', JSON.stringify(newUser));
                    return newUser;
                }
            }

            saveUser() {
                localStorage.setItem('xdragon_user', JSON.stringify(this.user));
                if (!this.database.users[this.user.id]) {
                    this.database.users[this.user.id] = this.user;
                    this.saveDatabase();
                }
            }

            generateId() {
                return 'id_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            }

            saveMessage(content, role) {
                const message = {
                    id: this.generateId(),
                    userId: this.user.id,
                    content: content,
                    role: role,
                    timestamp: new Date().toISOString()
                };
                this.database.messages.push(message);
                this.saveDatabase();
                return message;
            }

            saveScript(name, code, description) {
                const script = {
                    id: this.generateId(),
                    userId: this.user.id,
                    name: name,
                    code: code,
                    description: description,
                    model: this.user.selectedModel,
                    timestamp: new Date().toISOString()
                };
                this.database.scripts.push(script);
                this.saveDatabase();
                return script;
            }

            getUserScripts() {
                return this.database.scripts.filter(s => s.userId === this.user.id);
            }

            getUserMessages() {
                return this.database.messages.filter(m => m.userId === this.user.id);
            }

            clearUserData() {
                this.database.messages = this.database.messages.filter(m => m.userId !== this.user.id);
                this.database.scripts = this.database.scripts.filter(s => s.userId !== this.user.id);
                this.saveDatabase();
            }

            setModel(modelId) {
                this.user.selectedModel = modelId;
                this.saveUser();
                this.database.users[this.user.id] = this.user;
                this.saveDatabase();
            }
        }

        // ==================== AI ENGINE ====================
        class XdragonAI {
            constructor(cloudBase) {
                this.cloudBase = cloudBase;
                this.model = cloudBase.user.selectedModel;
            }

            setModel(modelId) {
                this.model = modelId;
                this.cloudBase.setModel(modelId);
            }

            getModelName() {
                return this.cloudBase.database.models[this.model].name;
            }

            generateResponse(prompt) {
                const lowerPrompt = prompt.toLowerCase();
                
                // Check for specific script types
                if (this.containsAny(lowerPrompt, ['speed', 'boost', 'fast', 'run', 'sprint'])) {
                    return this.generateSpeedScript();
                } else if (this.containsAny(lowerPrompt, ['teleport', 'tp', 'transport', 'portal', 'warp'])) {
                    return this.generateTeleportScript();
                } else if (this.containsAny(lowerPrompt, ['combat', 'fight', 'damage', 'attack', 'battle', 'sword', 'weapon'])) {
                    return this.generateCombatScript();
                } else if (this.containsAny(lowerPrompt, ['inventory', 'item', 'store', 'backpack', 'collect'])) {
                    return this.generateInventoryScript();
                } else if (this.containsAny(lowerPrompt, ['leaderboard', 'score', 'points', 'ranking', 'stats'])) {
                    return this.generateLeaderboardScript();
                } else if (this.containsAny(lowerPrompt, ['shop', 'buy', 'sell', 'money', 'currency', 'coins'])) {
                    return this.generateShopScript();
                } else if (this.containsAny(lowerPrompt, ['fly', 'flying', 'jump', 'double jump'])) {
                    return this.generateFlyScript();
                } else if (this.containsAny(lowerPrompt, ['camera', 'zoom', 'view', 'screen'])) {
                    return this.generateCameraScript();
                } else if (this.containsAny(lowerPrompt, ['part', 'spawn', 'create object', 'build'])) {
                    return this.generatePartScript();
                } else {
                    return this.generateCustomScript(prompt);
                }
            }

            containsAny(text, keywords) {
                return keywords.some(keyword => text.includes(keyword));
            }

            generateSpeedScript() {
                return {
                    name: 'Speed Boost Script',
                    description: 'Gives players a speed boost',
                    code: `-- Speed Boost Script
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        
        local SPEED_MULTIPLIER = 2 -- Adjust this value
        local BOOST_DURATION = 10 -- Duration in seconds
        
        local function applySpeedBoost(player)
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = 16 * SPEED_MULTIPLIER
                    
                    -- Reset speed after duration
                    task.delay(BOOST_DURATION, function()
                        if humanoid and humanoid.Parent then
                            humanoid.WalkSpeed = 16
                        end
                    end)
                end
            end
        end
        
        -- Apply to new players
        Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                task.wait(1)
                applySpeedBoost(player)
            end)
        end)
        
        -- Apply to existing players
        for _, player in ipairs(Players:GetPlayers()) do
            applySpeedBoost(player)
        end`
                };
            }

            generateTeleportScript() {
                return {
                    name: 'Teleport System',
                    description: 'Teleports players to different locations',
                    code: `-- Teleport System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        -- Define teleport locations
        local TELEPORT_LOCATIONS = {
            Spawn = Vector3.new(0, 10, 0),
            Shop = Vector3.new(100, 10, 50),
            Arena = Vector3.new(-50, 10, -100),
            Secret = Vector3.new(200, 50, 200)
        }
        
        -- Create remote event for teleporting
        local teleportEvent = Instance.new("RemoteEvent")
        teleportEvent.Name = "TeleportEvent"
        teleportEvent.Parent = ReplicatedStorage
        
        local function teleportPlayer(player, locationName)
            local character = player.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root and TELEPORT_LOCATIONS[locationName] then
                    root.CFrame = CFrame.new(TELEPORT_LOCATIONS[locationName])
                    print(player.Name .. " teleported to " .. locationName)
                end
            end
        end
        
        -- Handle teleport requests from client
        teleportEvent.OnServerEvent:Connect(function(player, locationName)
            teleportPlayer(player, locationName)
        end)
        
        -- Auto-teleport new players to spawn
        Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                task.wait(2)
                teleportPlayer(player, "Spawn")
            end)
        end)`
                };
            }

            generateCombatScript() {
                return {
                    name: 'Combat System',
                    description: 'Basic combat system with damage',
                    code: `-- Combat System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        -- Create remote events
        local attackEvent = Instance.new("RemoteEvent")
        attackEvent.Name = "AttackEvent"
        attackEvent.Parent = ReplicatedStorage
        
        local DAMAGE_AMOUNT = 10
        local ATTACK_COOLDOWN = 1 -- Seconds
        
        local cooldowns = {}
        
        local function dealDamage(attacker, target)
            local targetHumanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
            if targetHumanoid then
                targetHumanoid:TakeDamage(DAMAGE_AMOUNT)
                print(attacker.Name .. " attacked " .. target.Name .. " for " .. DAMAGE_AMOUNT .. " damage!")
            end
        end
        
        local function canAttack(player)
            local lastAttack = cooldowns[player.UserId] or 0
            return os.time() - lastAttack >= ATTACK_COOLDOWN
        end
        
        attackEvent.OnServerEvent:Connect(function(player, targetPlayer)
            if targetPlayer and targetPlayer ~= player and canAttack(player) then
                dealDamage(player, targetPlayer)
                cooldowns[player.UserId] = os.time()
            end
        end)`
                };
            }

            generateInventoryScript() {
                return {
                    name: 'Inventory System',
                    description: 'Item management system',
                    code: `-- Inventory System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        
        local Inventory = {}
        Inventory.__index = Inventory
        
        function Inventory.new(owner)
            local self = setmetatable({}, Inventory)
            self.Owner = owner
            self.Items = {}
            self.MaxSlots = 20
            return self
        end
        
        function Inventory:AddItem(itemName, quantity)
            quantity = quantity or 1
            if self.Items[itemName] then
                self.Items[itemName] += quantity
            else
                self.Items[itemName] = quantity
            end
        end
        
        function Inventory:RemoveItem(itemName, quantity)
            quantity = quantity or 1
            if self.Items[itemName] then
                self.Items[itemName] -= quantity
                if self.Items[itemName] <= 0 then
                    self.Items[itemName] = nil
                end
            end
        end
        
        function Inventory:GetItemCount(itemName)
            return self.Items[itemName] or 0
        end
        
        function Inventory:HasItem(itemName, quantity)
            return self:GetItemCount(itemName) >= (quantity or 1)
        end
        
        -- Store inventories for all players
        local playerInventories = {}
        
        Players.PlayerAdded:Connect(function(player)
            playerInventories[player.UserId] = Inventory.new(player)
            print(player.Name .. "'s inventory created!")
        end)
        
        Players.PlayerRemoving:Connect(function(player)
            playerInventories[player.UserId] = nil
        end)`
                };
            }

            generateLeaderboardScript() {
                return {
                    name: 'Leaderboard System',
                    description: 'Player stats and ranking',
                    code: `-- Leaderboard System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        
        local STATS = {
            "Score",
            "Coins",
            "Level",
            "Wins"
        }
        
        local function createLeaderboard(player)
            local leaderstats = Instance.new("Folder")
            leaderstats.Name = "leaderstats"
            leaderstats.Parent = player
            
            for _, statName in ipairs(STATS) do
                local stat = Instance.new("NumberValue")
                stat.Name = statName
                stat.Value = 0
                stat.Parent = leaderstats
            end
        end
        
        Players.PlayerAdded:Connect(createLeaderboard)
        
        -- Example: Give points when player joins
        Players.PlayerAdded:Connect(function(player)
            task.wait(1)
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local score = leaderstats:FindFirstChild("Score")
                if score then
                    score.Value += 10
                end
            end
        end)`
                };
            }

            generateShopScript() {
                return {
                    name: 'Shop System',
                    description: 'Buy and sell items',
                    code: `-- Shop System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        -- Shop items
        local SHOP_ITEMS = {
            {name = "Sword", price = 100, description = "Basic sword"},
            {name = "Shield", price = 150, description = "Basic shield"},
            {name = "Potion", price = 50, description = "Health potion"}
        }
        
        -- Create remote events
        local buyEvent = Instance.new("RemoteEvent")
        buyEvent.Name = "BuyEvent"
        buyEvent.Parent = ReplicatedStorage
        
        local function buyItem(player, itemName)
            local leaderstats = player:FindFirstChild("leaderstats")
            if not leaderstats then return end
            
            local coins = leaderstats:FindFirstChild("Coins")
            if not coins then return end
            
            for _, item in ipairs(SHOP_ITEMS) do
                if item.name == itemName then
                    if coins.Value >= item.price then
                        coins.Value -= item.price
                        print(player.Name .. " bought " .. item.name .. " for " .. item.price .. " coins!")
                        return true
                    else
                        print(player.Name .. " doesn't have enough coins!")
                        return false
                    end
                end
            end
        end
        
        buyEvent.OnServerEvent:Connect(buyItem)`
                };
            }

            generateFlyScript() {
                return {
                    name: 'Fly Script',
                    description: 'Allows players to fly',
                    code: `-- Fly Script
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        
        local FLY_SPEED = 50
        
        local function enableFly(player)
            local character = player.Character
            if not character then return end
            
            local root = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid then return end
            
            -- Create BodyVelocity and BodyGyro
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVelocity.Velocity = Vector3.zero
            bodyVelocity.Parent = root
            
            local bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bodyGyro.CFrame = root.CFrame
            bodyGyro.Parent = root
            
            -- Handle flying
            RunService.Heartbeat:Connect(function()
                if bodyVelocity and bodyVelocity.Parent then
                    local camera = workspace.CurrentCamera
                    local moveDirection = humanoid.MoveDirection
                    
                    if moveDirection.Magnitude > 0 then
                        bodyVelocity.Velocity = (camera.CFrame.LookVector * moveDirection.Z + camera.CFrame.RightVector * moveDirection.X) * FLY_SPEED
                    else
                        bodyVelocity.Velocity = Vector3.zero
                    end
                    
                    bodyGyro.CFrame = camera.CFrame
                end
            end)
        end
        
        Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                task.wait(1)
                -- enableFly(player) -- Uncomment to auto-enable
            end)
        end)`
                };
            }

            generateCameraScript() {
                return {
                    name: 'Camera System',
                    description: 'Camera manipulation',
                    code: `-- Camera System
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local Players = game:GetService("Players")
        
        local function setupCamera(player)
            player.CameraMinZoomDistance = 5
            player.CameraMaxZoomDistance = 50
            player.CameraMode = Enum.CameraMode.Classic
            
            print(player.Name .. "'s camera configured!")
        end
        
        Players.PlayerAdded:Connect(setupCamera)`
                };
            }

            generatePartScript() {
                return {
                    name: 'Part Spawner',
                    description: 'Creates parts in the game',
                    code: `-- Part Spawner
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        
        local function createPart(position, color, size)
            local part = Instance.new("Part")
            part.Position = position or Vector3.new(0, 10, 0)
            part.Color = color or Color3.fromRGB(255, 0, 0)
            part.Size = size or Vector3.new(4, 1, 4)
            part.Anchored = true
            part.Parent = workspace
            
            return part
        end
        
        -- Example: Create a platform
        local platform = createPart(
            Vector3.new(0, 10, 0),
            Color3.fromRGB(0, 255, 0),
            Vector3.new(10, 1, 10)
        )`
                };
            }

            generateCustomScript(prompt) {
                return {
                    name: 'Custom Script',
                    description: prompt,
                    code: `-- Custom Script for: ${prompt}
        -- Generated by Dev Xdragon Hub AI (${this.getModelName()})
        -- Date: ${new Date().toLocaleString()}
        
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        -- Main function
        local function main()
            print("Script initialized!")
            
            -- TODO: Add your custom logic here
        end
        
        -- Start the script
        main()
        
        -- Connect to player events
        Players.PlayerAdded:Connect(function(player)
            print(player.Name .. " joined the game!")
            
            player.CharacterAdded:Connect(function(character)
                print(player.Name .. " spawned!")
            end)
        end)`
                };
            }
        }

        // ==================== APP INITIALIZATION ====================
        const cloudBase = new CloudBase();
        const ai = new XdragonAI(cloudBase);
        let currentModel = cloudBase.user.selectedModel;
        let currentTab = 'studio';

        // Initialize
        updateUI();

        function updateUI() {
            document.getElementById('username').textContent = cloudBase.user.username;
            document.getElementById('userAvatar').textContent = cloudBase.user.username[0].toUpperCase();
            document.getElementById('settingsUsername').textContent = cloudBase.user.username;
            document.getElementById('settingsModel').textContent = cloudBase.database.models[currentModel].name;
            updateModelSelection();
            updateSavedScripts();
        }

        function updateModelSelection() {
            const cards = document.querySelectorAll('.model-card');
            cards.forEach(card => {
                card.classList.remove('selected');
            });
            const selectedCard = document.querySelector(`[onclick="selectModel('${currentModel}')"]`);
            if (selectedCard) {
                selectedCard.classList.add('selected');
            }
            
            const modelInfo = document.getElementById('modelInfo');
            const modelData = cloudBase.database.models[currentModel];
            modelInfo.innerHTML = `
                <h3>Selected Model: ${modelData.name}</h3>
                <p>${modelData.description}</p>
                <p><strong>Speed:</strong> ${modelData.speed}% | <strong>Complexity:</strong> ${modelData.complexity}%</p>
                <p><strong>Specializations:</strong> ${modelData.specialization.join(', ')}</p>
            `;
        }

        function selectModel(modelId) {
            currentModel = modelId;
            ai.setModel(modelId);
            updateUI();
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
            document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
            
            switch(tab) {
                case 'studio':
                    document.getElementById('studioTab').style.display = 'block';
                    document.querySelector('.sidebar-btn:nth-child(1)').classList.add('active');
                    break;
                case 'ai':
                    document.getElementById('aiTab').style.display = 'block';
                    document.querySelector('.sidebar-btn:nth-child(2)').classList.add('active');
                    break;
                case 'saved':
                    document.getElementById('savedTab').style.display = 'block';
                    document.querySelector('.sidebar-btn:nth-child(3)').classList.add('active');
                    updateSavedScripts();
                    break;
                case 'settings':
                    document.getElementById('settingsTab').style.display = 'block';
                    document.querySelector('.sidebar-btn:nth-child(4)').classList.add('active');
                    break;
            }
        }

        function sendPrompt() {
            const promptInput = document.getElementById('promptInput');
            const prompt = promptInput.value.trim();
            
            if (!prompt) return;
            
            // Add user message to chat
            addMessage(prompt, 'user');
            
            // Generate AI response
            const response = ai.generateResponse(prompt);
            
            // Save message to cloud
            cloudBase.saveMessage(prompt, 'user');
            cloudBase.saveMessage(response.description, 'ai');
            
            // Add AI response to chat
            setTimeout(() => {
                addMessage(`Here's your ${response.name}! (${response.description})`, 'ai');
                addCodeBlock(response.code);
                
                // Save script to cloud
                cloudBase.saveScript(response.name, response.code, response.description);
            }, 500);
            
            // Clear input
            promptInput.value = '';
        }

        function addMessage(text, role) {
            const chatContainer = document.getElementById('chatContainer');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${role}`;
            
            if (role === 'ai') {
                messageDiv.innerHTML = `<strong>Dev Xdragon Hub AI:</strong><br>${text}<div class="timestamp">${new Date().toLocaleTimeString()}</div>`;
            } else {
                messageDiv.innerHTML = `${text}<div class="timestamp">${new Date().toLocaleTimeString()}</div>`;
            }
            
            chatContainer.appendChild(messageDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function addCodeBlock(code) {
            const chatContainer = document.getElementById('chatContainer');
            const codeDiv = document.createElement('div');
            codeDiv.className = 'code-block';
            codeDiv.innerHTML = `<button class="copy-btn" onclick="copyCode(this)">Copy 📋</button><pre>${escapeHtml(code)}</pre>`;
            chatContainer.appendChild(codeDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function copyCode(btn) {
            const pre = btn.nextElementSibling;
            const code = pre.textContent;
            navigator.clipboard.writeText(code).then(() => {
                btn.textContent = 'Copied! ✅';
                setTimeout(() => {
                    btn.textContent = 'Copy 📋';
                }, 2000);
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function updateSavedScripts() {
            const savedScripts = document.getElementById('savedScripts');
            const scripts = cloudBase.getUserScripts();
            
            if (scripts.length === 0) {
                savedScripts.innerHTML = '<p>No saved scripts yet. Generate some code first!</p>';
                return;
            }
            
            savedScripts.innerHTML = '';
            scripts.reverse().forEach(script => {
                const scriptItem = document.createElement('div');
                scriptItem.className = 'saved-script-item';
                scriptItem.innerHTML = `
                    <strong>${script.name}</strong><br>
                    <small>${script.description} | ${new Date(script.timestamp).toLocaleString()}</small>
                `;
                scriptItem.onclick = () => viewScript(script);
                savedScripts.appendChild(scriptItem);
            });
        }

        function viewScript(script) {
            const chatContainer = document.getElementById('chatContainer');
            chatContainer.innerHTML = '';
            addMessage(`Loaded saved script: ${script.name}`, 'ai');
            addCodeBlock(script.code);
            switchTab('ai');
        }

        function clearCloud() {
            if (confirm('Are you sure you want to clear all your cloud data?')) {
                cloudBase.clearUserData();
                updateUI();
                alert('Cloud data cleared successfully!');
            }
        }

        // Handle Enter key for prompt input
        document.getElementById('promptInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendPrompt();
            }
        });

        // Auto-save user data
        window.addEventListener('beforeunload', function() {
            cloudBase.saveUser();
            cloudBase.saveDatabase();
        });

        console.log('🚀 Dev Xdragon Hub AI initialized successfully!');
        console.log('📦 CloudBase connected with user:', cloudBase.user.username);
        console.log('🤖 AI Models available:', Object.keys(cloudBase.database.models));
    </script>
</body>
</html>
